# Copy to .env and adjust. Only variables prefixed with VITE_ reach the browser bundle.

# Backend API base URL. Manual setup runs Django on port 8000; the Docker
# quickstart publishes it on 8010 and sets this automatically.
VITE_API_BASE_URL=http://localhost:8000/api
