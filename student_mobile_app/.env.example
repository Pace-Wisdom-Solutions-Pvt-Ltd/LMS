# Template for the env file. Copy it once:
#
#   cp .env.example .env
#
# .env is declared as an asset in pubspec.yaml, so **it must exist before the
# app will build** — a missing one fails the asset bundling step, not at
# runtime. Keep this file in sync whenever a key is added.
#
# NOTE: --dart-define=API_BASE_URL wins over this file and is what release
# builds and CI should use. This file exists so a plain `flutter run` works
# without flags during development. There is deliberately no hardcoded host in
# source; with neither set, every request fails loudly.

# API root. No trailing slash. e.g. https://lms.example.com
API_BASE_URL=
