# Core Django settings
SECRET_KEY=change-this-to-a-secure-secret-key-in-production
DEBUG=True
ALLOWED_HOSTS=*

# Database configuration
DB_NAME=lms_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# URL where your frontend is running
FRONTEND_URL=http://localhost:5173

# URL where your backend is running
BACKEND_PUBLIC_URL=http://localhost:8000

# Rate limits for login, password reset and invite endpoints (requests/second|minute|hour|day)
THROTTLE_RATE_LOGIN=5/minute
THROTTLE_RATE_PASSWORD_RESET_EMAIL=5/hour
THROTTLE_RATE_AUTH_TOKEN=10/minute
# Number of reverse proxies in front of the app, used to find the client IP for rate limiting
# NUM_PROXIES=1

# Email settings
DEFAULT_FROM_EMAIL=no-reply@example.com
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_REGION=ap-south-1

# Object Storage (S3 / MinIO)
USE_S3=False
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1

# Caching & Celery Background Tasks
REDIS_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=django-db
